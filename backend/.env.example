PROJECT_NAME="SML GO API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
# Generate using: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-it-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="mysql+pymysql://user:password@localhost:3306/sml_go"

# SFTP Storage Config
SFTP_HOST="sftp.sml.com.pe"
SFTP_PORT=22
SFTP_USERNAME="username"
SFTP_PASSPHRASE="change_this_passphrase"
SFTP_REMOTE_DIR="/ruta/a/la/carpeta/destino"
MEDIA_PUBLIC_URL_BASE="http://[IP_ADDRESS or DOMAIN]"
